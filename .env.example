# Copy this file to .env for local development.

# FastAPI / SQLAlchemy
# Local host connection to the Postgres container published by compose.yml.
# The api and airflow containers override DATABASE_URL to use postgres:5432 internally.
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@localhost:5433/rag_db

# Airflow
# Used by the airflow container through compose.yml env_file.
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW__HOME=/opt/airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_db
